#include <windows.h>
#include "resource.h"

IDI_ON      ICON "../res/tiro_on.ico"
IDI_OFF     ICON "../res/tiro_off.ico"
IDI_LOADING ICON "../res/tiro_loading.ico"

IDD_ABOUT DIALOGEX 0, 0, 268, 172
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Tiro"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_ABOUT_TEXT, 12, 12, 244, 132
    PUSHBUTTON      "Copy details", IDC_COPY, 12, 148, 74, 15
    DEFPUSHBUTTON   "Close", IDCANCEL, 182, 148, 74, 15
END

IDD_HOTKEY DIALOGEX 0, 0, 228, 116
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configure Hotkey"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Current shortcut:", -1, 12, 12, 74, 8
    LTEXT           "", IDC_HOTKEY_CURRENT, 92, 12, 124, 8
    LTEXT           "Press the new combination now:", -1, 12, 32, 150, 8
    EDITTEXT        IDC_HOTKEY_CAPTURE, 12, 44, 204, 14, ES_CENTER | ES_READONLY | WS_BORDER
    LTEXT           "", IDC_HOTKEY_ERROR, 12, 64, 204, 16
    PUSHBUTTON      "Clear", IDC_CLEAR, 12, 90, 60, 15
    DEFPUSHBUTTON   "OK", IDOK, 82, 90, 60, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 152, 90, 64, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 1,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Piyush Raizada"
            VALUE "FileDescription", "Tiro dictation"
            VALUE "FileVersion", "1.1.1.0"
            VALUE "InternalName", "Tiro"
            VALUE "OriginalFilename", "Tiro.exe"
            VALUE "ProductName", "Tiro"
            VALUE "ProductVersion", "1.1.1.0"
            VALUE "LegalCopyright", "Speech model licensed by NVIDIA Corporation under the NVIDIA Open Model License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
