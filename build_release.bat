@echo off
setlocal enabledelayedexpansion
rem Locate and load the MSVC environment. vswhere ships with every Visual Studio
rem 2017+ installer; the hard-coded folders are a fallback for stripped installs.
set VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe
set VSPATH=
if exist "!VSWHERE!" (
    for /f "usebackq delims=" %%i in (`"!VSWHERE!" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath 2^>nul`) do set VSPATH=%%i
)
set VCVARS=
if defined VSPATH if exist "!VSPATH!\VC\Auxiliary\Build\vcvars64.bat" set VCVARS=!VSPATH!\VC\Auxiliary\Build\vcvars64.bat
if not defined VCVARS (
    for %%r in (
        "%ProgramFiles%\Microsoft Visual Studio\2026\Community"
        "%ProgramFiles%\Microsoft Visual Studio\2026\Professional"
        "%ProgramFiles%\Microsoft Visual Studio\2026\Enterprise"
        "%ProgramFiles%\Microsoft Visual Studio\2026\BuildTools"
        "%ProgramFiles%\Microsoft Visual Studio\18\Community"
        "%ProgramFiles%\Microsoft Visual Studio\18\Professional"
        "%ProgramFiles%\Microsoft Visual Studio\18\Enterprise"
        "%ProgramFiles%\Microsoft Visual Studio\18\BuildTools"
        "%ProgramFiles%\Microsoft Visual Studio\2022\Community"
        "%ProgramFiles%\Microsoft Visual Studio\2022\Professional"
        "%ProgramFiles%\Microsoft Visual Studio\2022\Enterprise"
        "%ProgramFiles%\Microsoft Visual Studio\2022\BuildTools"
    ) do (
        if not defined VCVARS if exist "%%~r\VC\Auxiliary\Build\vcvars64.bat" set VCVARS=%%~r\VC\Auxiliary\Build\vcvars64.bat
    )
)
if not defined VCVARS (
    echo error: vcvars64.bat was not found.
    echo        Install Visual Studio with the "Desktop development with C++" workload,
    echo        or run this script from the "x64 Native Tools Command Prompt for VS".
    exit /b 1
)
call "!VCVARS!" >nul
if errorlevel 1 (
    echo error: could not initialise the MSVC environment from
    echo        !VCVARS!
    exit /b 1
)
echo toolchain: !VCVARS!

rem Stamp the exact commit into src\gitver.h (generated, gitignored) so the About box and
rem the log name the bits: Tiro 1.0.0 (4765fdf). -dirty = uncommitted changes went in.
set TIROHASH=unknown
set GITCMD=git
if exist "C:\Program Files\Git\cmd\git.exe" set GITCMD="C:\Program Files\Git\cmd\git.exe"
for /f "usebackq delims=" %%h in (`%GITCMD% rev-parse --short HEAD 2^>nul`) do set TIROHASH=%%h
if not "!TIROHASH!"=="unknown" %GITCMD% status --porcelain --untracked-files=no 2>nul | findstr /r "." >nul && set TIROHASH=!TIROHASH!-dirty
>src\gitver.h.tmp echo // generated by build_release.bat - do not edit, do not commit
>>src\gitver.h.tmp echo #define TIRO_GIT_HASH L"!TIROHASH!"
fc /b src\gitver.h.tmp src\gitver.h >nul 2>&1 || copy /y src\gitver.h.tmp src\gitver.h >nul
del src\gitver.h.tmp >nul 2>&1
echo stamp: !TIROHASH!

rem --- 4b. unpack the speech-engine libraries if they are not there ----------
rem They ship in the repository as a 55 MB .tar.xz: the 14 archives are 1.1 GB
rem raw and Git refuses any single file over 100 MB (onnxruntime.lib alone is
rem 944 MB), so the SDK is stored compressed and unpacked here, once.
rem Windows ships tar.exe (bsdtar with liblzma) since Windows 10 1803. Call it by
rem absolute path on purpose: a tar from Git for Windows, Cygwin or MSYS earlier
rem on PATH cannot read .tar.xz and fails with "Access is denied", which looks
rem like a permissions problem instead of the wrong tool.
set "TAREXE=%SystemRoot%\System32\tar.exe"
set "TIRO_LIBS=third_party\sherpa-onnx-v2.0.3-win-x64-static-MT-Release-no-tts-lib"
if not exist "%TIRO_LIBS%\lib\onnxruntime.lib" (
    if not exist "%TIRO_LIBS%.tar.xz" (
        echo error: %TIRO_LIBS% is missing and %TIRO_LIBS%.tar.xz is not there either
        exit /b 1
    )
    if not exist "%TAREXE%" (
        echo error: %TAREXE% was not found.
        echo        Windows 10 1803 or newer is needed to unpack %TIRO_LIBS%.tar.xz
        exit /b 1
    )
    echo libs: unpacking %TIRO_LIBS%.tar.xz ^(about a minute^)
    "%TAREXE%" -xf "%CD%\%TIRO_LIBS%.tar.xz" -C "%CD%\third_party"
    if errorlevel 1 ( echo error: could not unpack the speech-engine libraries ^(tar exit %ERRORLEVEL%^) & exit /b 1 )
    if not exist "%TIRO_LIBS%\lib\onnxruntime.lib" ( echo error: unpack created no libraries & exit /b 1 )
)

msbuild Tiro.vcxproj /p:Configuration=Release /p:Platform=x64 /m /v:m
if errorlevel 1 exit /b 1

rem The deployment folder IS bin\Release: ship the end-user documents beside the exe.
rem The About box and README.txt both promise LICENSE.txt / NOTICE.txt / SECURITY.md there.
rem The first three live in dist\; SECURITY.md stays at the repository root so it is
rem also GitHub's security policy - one copy, no duplication.
for %%f in (LICENSE.txt NOTICE.txt README.txt) do (
    if exist "dist\%%f" copy /y "dist\%%f" "bin\Release\%%f" >nul
)
if exist "SECURITY.md" copy /y "SECURITY.md" "bin\Release\SECURITY.md" >nul

rem --- 5. make the model visible beside the exe -----------------------------
rem Tiro reads <exe folder>\models. Linking the repository's models folder into
rem the output avoids copying 633 MB on every build and keeps one copy on disk.
if exist "models" if not exist "bin\Release\models" (
    mklink /J "bin\Release\models" "%CD%\models" >nul 2>&1
    if errorlevel 1 (
        echo warning: could not create the bin\Release\models link.
        echo          Copy the models folder next to Tiro.exe by hand.
    ) else (
        echo models: linked bin\Release\models -^> %CD%\models
    )
)
rem A link created by an earlier build, or a folder someone copied by hand, both
rem satisfy "if exist", so a new model dropped into models\ would otherwise never
rem appear beside the exe. Say so instead of leaving it to be discovered.
if exist "bin\Release\models" (
    fsutil reparsepoint query "bin\Release\models" >nul 2>&1
    if errorlevel 1 (
        echo note: bin\Release\models is a real folder, not a link to models\.
        echo       Models added under models\ will not appear beside the exe;
        echo       copy them into bin\Release\models to dictate with them.
    )
)

if not exist "bin\Release\models\nemotron-0.6b-en\model.json" (
    echo.
    echo warning: models\nemotron-0.6b-en is missing, so Tiro will start but
    echo          cannot dictate. See BUILD.md, "Get the speech model".
)

echo.
echo built: bin\Release\Tiro.exe
exit /b 0
